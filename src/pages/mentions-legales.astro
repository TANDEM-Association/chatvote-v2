---
// Page statique (prérendue). Contenu repris des mentions légales du site Tandem.
import LegalPage from "../components/LegalPage.astro";

const tandemHref = (import.meta.env.PUBLIC_LOGO_TANDEM_HREF ?? "").replace(
  /\/$/,
  "",
);
const contactHref = tandemHref ? `${tandemHref}/contact` : "";
---

<LegalPage
  title="Mentions légales - ChatVote"
  description="Mentions légales de l'application ChatVote : éditeur, hébergeur, propriété intellectuelle, responsabilité et données personnelles."
  heading="Mentions légales"
>

  <section class="block">
    <h2>Éditeur</h2>
    <p>
      <strong>TANDEM</strong><br />
      Association déclarée (loi du 1er juillet 1901)<br />
      24 rue Noble<br />
      63450 Saint-Saturnin<br />
      France
    </p>
    <p>
      Contact : Contactez-nous via notre{" "}
      {
        contactHref ? (
          <a href={contactHref} target="_blank" rel="noopener noreferrer">
            formulaire de contact
          </a>
        ) : (
          "formulaire de contact"
        )
      }<br />
      Numéro SIREN : 993 612 613<br />
      Numéro SIRET : 993 612 613 00014<br />
      Numéro RNA : W632015452<br />
      Responsable de la publication : Stanislas Vandier, Président
    </p>
  </section>

  <section class="block">
    <h2>Hébergeur</h2>
    <p>
      <strong>Scaleway SAS</strong><br />
      Société par actions simplifiée au capital de 142 050 €<br />
      8 rue de la Ville-l’Évêque<br />
      75008 Paris<br />
      France
    </p>
    <p>
      SIREN : 433 115 904 RCS Paris<br />
      N° de TVA intracommunautaire : FR 35 433115904<br />
      Site :{" "}
      <a
        href="https://www.scaleway.com"
        target="_blank"
        rel="noopener noreferrer">www.scaleway.com</a
      >
    </p>
  </section>

  <section class="block">
    <h2>Propriété intellectuelle</h2>
    <p>
      L’ensemble des contenus de l’application Chat Vote (textes, images,
      logos, graphismes, vidéos, etc.) est la propriété de l’association
