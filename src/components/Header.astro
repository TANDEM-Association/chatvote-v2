---
import CommuneTrigger from "./CommuneTrigger.astro";
import ViewToggle from "./ViewToggle.astro";

interface Props {
  /** Nom de la commune affichée ; absent si elle est introuvable. */
  communeName?: string | undefined;
}

const { communeName } = Astro.props;

// Logo ChatVote « par » logo Tandem. Contenu final à définir avec le porteur du projet.
// TODO: PUBLIC_LOGO_HREF à définir (clic sur le logo ChatVote) ; vide = logo sans lien.
const logoHref = import.meta.env.PUBLIC_LOGO_HREF;
const logoTandemHref = import.meta.env.PUBLIC_LOGO_TANDEM_HREF;
---

<header class="header">
  {
    logoHref ? (
      <a class="brand" href={logoHref}  aria-label="ChatVote">
        <img class="logo" src="/logo-chatvote.svg" alt="" width="500" height="500" />
      </a>
    ) : (
      <img class="logo" src="/logo-chatvote.svg" alt="ChatVote" width="500" height="500" />
    )
  }
  <span class="by">par</span>
  <a class="brand" href={logoTandemHref} target="_blank" rel="noopener noreferrer" aria-label="Tandem (s'ouvre dans un nouvel onglet)" >
  <img class="tandem" src="/tandem-logo.svg" alt="Tandem, tech et démocratie" width="402" height="140" />
  </a>
  <div class="end">
    <CommuneTrigger variant="pill" name={communeName} />
    <ViewToggle />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--header-height);
    padding-inline: var(--gutter);
    background: var(--surface-100);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
  }

  /* Pastille de commune (≥ 1024 px) et bascule, poussées à droite. */
  .end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .logo {
    height: calc(var(--header-height) - var(--space-3));
    width: auto;
  }

  .by {
    color: var(--ink-secondary);
    font-size: var(--body-md-size);
    line-height: 1;
  }

  .tandem {
    height: 2rem;
    width: auto;
  }

  @media (min-width: 768px) {
    .header {
      gap: var(--space-4);
    }

    .tandem {
      height: 2.75rem;
    }
  }
</style>
