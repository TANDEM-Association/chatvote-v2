---
const year = new Date().getFullYear();
---

<footer class="footer">
  <p>© {year} TANDEM — Tech &amp; Démocratie</p>
  <p class="beta">Version 1.1 BETA en cours de développement</p>
  <p>Association loi 1901 · Saint-Saturnin</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--gutter);
    background: var(--surface-100);
    border-top: 1px solid var(--border);
    color: var(--ink-secondary);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-line);
   
    .beta {
    color: var(--ink);
    font-style: italic;
  }
  }

  
  @media (min-width: 640px) {
    .footer {
      flex-direction: row;
      align-items: normal;
      text-align: start;
      justify-content: space-between;
    }
  }
</style>
