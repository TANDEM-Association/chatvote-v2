---
// L'iframe est rendu sans src : chat-frame.ts le renseigne côté navigateur
// (code commune de l'URL parente + userID du cookie).
const {
  PUBLIC_CHAT_URL,
  PUBLIC_CHAT_MUNICIPALITY_PARAM,
  PUBLIC_DEFAULT_MUNICIPALITY_CODE,
  PUBLIC_CHAT_USER_ID_PARAM,
  PUBLIC_USER_ID_COOKIE_MAX_AGE,
} = import.meta.env;

// Échec du build si la configuration est inutilisable.
const chatUrl = new URL(PUBLIC_CHAT_URL);
if (chatUrl.protocol !== "https:") {
  throw new Error("PUBLIC_CHAT_URL doit être une URL https.");
}
---

<div class="frame" data-chat-frame>
  <div class="skeleton" aria-hidden="true"></div>
  <iframe
    title="ChatVote : assistant d'information sur les programmes municipaux"
    allow="clipboard-write"
    data-chat-url={chatUrl.toString()}
    data-municipality-param={PUBLIC_CHAT_MUNICIPALITY_PARAM}
    data-default-municipality={PUBLIC_DEFAULT_MUNICIPALITY_CODE}
    data-user-id-param={PUBLIC_CHAT_USER_ID_PARAM}
    data-cookie-max-age={PUBLIC_USER_ID_COOKIE_MAX_AGE}></iframe>
  <noscript>
    <p class="noscript">Activez JavaScript pour utiliser ChatVote.</p>
  </noscript>
</div>

<script>
  import "../scripts/chat-frame";
</script>

<style>
  .frame {
    position: relative;
    flex: 1;
    display: flex;
    min-width: 0;
    min-height: 0;
  }

  iframe {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 0;
  }

  .skeleton {
    position: absolute;
    inset: 0;
    background: var(--surface-200);
    animation: pulse 1.5s ease-in-out infinite;
  }

  .frame[data-loaded] .skeleton {
    display: none;
  }

  .noscript {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    text-align: center;
  }

  @keyframes pulse {
    50% {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skeleton {
      animation: none;
    }
  }
</style>
