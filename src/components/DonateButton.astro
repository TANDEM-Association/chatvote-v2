---
// Bouton « Soutenir » (PUBLIC_DONATE_URL ; vide = rien n'est rendu).
//  - « responsive » : libellé long dès 640 px (bandeau) ;
//  - « short »      : toujours « Soutenir » (header mobile).
// TODO: PUBLIC_DONATE_URL à définir.

interface Props {
  label?: "responsive" | "short";
  class?: string;
}

const { label = "responsive", class: className } = Astro.props;
const donateUrl = import.meta.env.PUBLIC_DONATE_URL;
---

{
  donateUrl && (
    <a
      class:list={["donate", label, className]}
      href={donateUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
      </svg>
      <span class="donate-long">Aidez-nous à aider la démocratie !</span>
      <span class="donate-short">Soutenir</span>
      <span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
    </a>
  )
}

<style>
  .donate {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 2rem;
    padding-inline: var(--space-3);
    background: var(--brand-orange);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;

    &:hover {
      background: color-mix(in srgb, var(--brand-orange) 80%, transparent);
    }
  }

  .heart {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .donate-long {
    display: none;
  }

  @media (min-width: 640px) {
    .responsive {
      & .donate-long {
        display: inline;
      }

      & .donate-short {
        display: none;
      }
    }
  }

  @media (min-width: 768px) {
    .donate {
      height: 2.25rem;
      font-size: 0.875rem;
    }

    .heart {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
