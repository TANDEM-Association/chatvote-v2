---
// Modale qui recouvre le chat (mais ni le header ni le footer).
// Vue liste + une vue détail par séance ; records-modal.ts bascule de l'une à
// l'autre et charge le contenu d'une séance à sa première ouverture.
// Les séances viennent de l'index de la commune dans le stockage des PV
// augmentés (lu au rendu de la page, voir lib/pv). Sans séance : un message.
import { pvStore } from "../lib/pv/pv-server";
import RecordDetail from "./RecordDetail.astro";
import RecordsList from "./RecordsList.astro";

interface Props {
  /** Code INSEE de la commune affichée ; absent si la commune est introuvable. */
  communeCode?: string | undefined;
  communeName?: string | undefined;
}

const { communeCode, communeName } = Astro.props;

const result = communeCode
  ? await pvStore.getIndex(communeCode)
  : ({ status: "none" } as const);
const seances = result.status === "ok" ? result.value.seances : [];

const emptyMessage =
  result.status === "error"
    ? "Les comptes rendus sont momentanément indisponibles. Réessayez dans quelques minutes."
    : communeName
      ? `Les comptes rendus de ${communeName} ne sont pas encore disponibles dans ChatVote.`
      : "Aucun compte rendu à afficher.";
---

<div class="modal" id="records-modal" data-records-modal role="dialog" aria-label="Comptes rendus" inert>
  <div class="bar">
    <h2 class="heading">Comptes rendus</h2>
    <button type="button" class="close" data-records-close aria-label="Fermer les comptes rendus">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="content" data-records-content>
    {
      communeCode && seances.length > 0 ? (
        <>
          <RecordsList seances={seances} />
          {seances.map((seance) => (
            <RecordDetail seance={seance} communeCode={communeCode} />
          ))}
        </>
      ) : (
        <p class="empty" data-records-empty>{emptyMessage}</p>
      )
    }
  </div>
</div>

<script>
  import "../scripts/records-modal";
</script>

<style>
  /* Contenu en thème clair (comme le chat), indépendant du thème sombre du site. */
  .modal {
    --modal-bg: #f8f8ff;
    --modal-ink: #11103a;
    --modal-ink-secondary: #5b5b7a;
    --modal-border: #e4e4f2;

    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    background: var(--modal-bg);
    color: var(--modal-ink);
    color-scheme: light;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.15s ease,
      visibility 0.15s;

    &[data-open] {
      opacity: 1;
      visibility: visible;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--gutter);
    border-bottom: 1px solid var(--modal-border);
  }

  .heading {
    font-size: var(--body-lg-size);
    font-weight: 700;
    line-height: var(--body-lg-line);
  }

  .close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--modal-bg);
    border: 1px solid var(--modal-border);
    border-radius: var(--radius-full);
    color: var(--modal-ink);
    cursor: pointer;

    &:hover {
      border-color: var(--modal-ink-secondary);
    }
  }

  .content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .empty {
    padding: var(--space-6) var(--gutter);
    color: var(--modal-ink-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .modal {
      transition: none;
    }
  }
</style>
