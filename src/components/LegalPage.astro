---
// Mise en page commune des pages légales (mentions légales, politique de
// confidentialité). Fond clair comme tndm.fr ; valeurs reprises de la page Tandem
// (mobile-first). Le contenu (sections `.block`) vient du slot : ses styles sont
// donc déclarés avec :global(), sous `.page`.
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  /** Titre de la page (onglet) et description (balise meta). */
  title: string;
  description: string;
  /** Titre affiché (h1). */
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="page" aria-labelledby="legal-title">
    <div class="container">
      <div class="header">
        <p class="eyebrow">Légal</p>
        <h1 id="legal-title">{heading}</h1>
        <slot name="intro" />
      </div>

      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    --surface-100: #fbfbfb;
    --ink: #170742;
    --ink-secondary: #170742a6;
    --border: #1707421f;
    --focus-ring: var(--brand-indigo);
    --page-gutter: 1.5rem;
    flex: 1;
    padding: 3rem 0;
    background: var(--surface-100);
    color: var(--ink);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    width: 100%;
    max-width: calc(45rem + 2 * var(--page-gutter));
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .eyebrow {
    color: var(--ink-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 2.125rem;
  }

  .page :global(.block) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .page :global(.block h2) {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.625rem;
  }

  .page :global(.block h3) {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .page :global(.block p),
  .page :global(.block ul) {
    max-width: 70ch;
  }

  .page :global(.block ul) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .page :global(.version),
  .page :global(.intro) {
    max-width: 70ch;
  }

  .page :global(.version) {
    color: var(--ink-secondary);
    font-size: 0.875rem;
  }

  .page :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .page {
      --page-gutter: 3rem;
      padding: 4rem 0;
    }

    h1 {
      font-size: 2.5rem;
      line-height: 2.875rem;
    }

    .page :global(.block h2) {
      font-size: 1.75rem;
      font-weight: 600;
      line-height: 2.125rem;
    }

    .page :global(.block h3) {
      font-size: 1.25rem;
      line-height: 1.625rem;
    }

    .eyebrow {
      font-size: 0.8125rem;
    }
  }

  @media (min-width: 1024px) {
    .page {
      --page-gutter: 6rem;
      padding: 6rem 0;
    }
  }
</style>
