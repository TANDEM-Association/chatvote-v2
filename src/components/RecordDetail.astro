---
// Vue détail d'une séance, masquée jusqu'au clic dans la liste.
// L'en-tête vient de l'index ; le PV augmenté lui-même (HTML converti par le
// serveur) est chargé à la première ouverture par records-modal.ts, depuis
// /api/pv/… : la page ne transporte pas tous les PV de la commune.
// Styles hérités des variables --modal-*.
import { formatDeliberations, formatSeanceDate } from "../lib/pv/pv-display";
import type { PvSeance } from "../lib/pv/pv-format";
import { pvFileUrl } from "../lib/pv/pv-server";

interface Props {
  seance: PvSeance;
  communeCode: string;
}

const { seance, communeCode } = Astro.props;
const longDate = formatSeanceDate(seance.date);
---

<article class="detail" data-record-detail={seance.id} hidden>
  <header class="head">
    <button type="button" class="back" data-record-back aria-label="Retour à la liste">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7M19 12H5" />
      </svg>
    </button>
    <div class="head-text">
      <h3 class="title">Conseil municipal du {longDate}</h3>
      <p class="meta">
        <span>{formatDeliberations(seance.nbDeliberations)}</span>
        <span class="sep" aria-hidden="true">·</span>
        <a class="link" href={pvFileUrl(communeCode, seance.id, "pdf")} target="_blank" rel="noopener">
          Télécharger (PDF)
        </a>
        {
          seance.sourceUrl && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <a class="link" href={seance.sourceUrl} target="_blank" rel="noopener noreferrer">
                PV officiel
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              </a>
            </>
          )
        }
      </p>
    </div>
  </header>

  <div class="topics">
    <span class="topics-label">Sujets :</span>
    <ul class="chips">
      {seance.sujets.map((sujet) => <li class="chip">{sujet}</li>)}
    </ul>
  </div>

  <div class="status" data-pv-status>
    <p data-pv-message>Chargement du compte rendu…</p>
    <button type="button" class="retry" data-pv-retry hidden>Réessayer</button>
  </div>
  <section class="md" data-pv-body data-pv-src={pvFileUrl(communeCode, seance.id, "html")} aria-label={`Compte rendu du ${longDate}`}></section>
</article>

<style>
  .detail {
    --detail-muted: color-mix(in srgb, var(--modal-ink) 4%, var(--modal-bg));
  }

  .head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter);
    border-bottom: 1px solid var(--modal-border);
  }

  .back {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: 0;
    border-radius: var(--radius-full);
    color: var(--modal-ink-secondary);
    cursor: pointer;

    &:hover {
      color: var(--modal-ink);
    }
  }

  .head-text {
    min-width: 0;
  }

  .title {
    font-size: var(--body-md-size);
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--modal-ink-secondary);
    font-size: var(--body-sm-size);
  }

  .sep {
    opacity: 0.5;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--brand-indigo);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--gutter);
    background: var(--detail-muted);
    border-bottom: 1px solid var(--modal-border);
    font-size: var(--body-sm-size);
  }

  .topics-label {
    color: var(--modal-ink-secondary);
  }

  .chips {
    display: contents;
    list-style: none;
  }

  .chip {
    padding: 2px var(--space-3);
    border: 1px solid color-mix(in srgb, var(--brand-indigo) 40%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--brand-indigo) 5%, transparent);
    color: var(--brand-indigo);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--gutter);
    color: var(--modal-ink-secondary);

    &[hidden] {
      display: none;
    }
  }

  .retry {
    padding: var(--space-1) var(--space-4);
    background: var(--modal-bg);
    border: 1px solid var(--modal-border);
    border-radius: var(--radius-full);
    color: var(--modal-ink);
    font-weight: 600;
    cursor: pointer;

    &:hover {
      border-color: var(--modal-ink-secondary);
    }
  }

  /* Contenu injecté depuis /api/pv/… : styles en :global (hors portée d'Astro). */
  .md {
    padding: var(--space-4) var(--gutter) var(--space-8);
    overflow-wrap: anywhere;

    &:empty {
      display: none;
    }

    & > :global(:first-child) {
      margin-top: 0;
    }

    & :global(h2) {
      margin: var(--space-8) 0 var(--space-3);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--modal-border);
      font-size: 1.25rem;
      line-height: 1.3;
    }

    & :global(h3) {
      margin: var(--space-6) 0 var(--space-2);
      font-size: 1.0625rem;
      line-height: 1.35;
    }

    & :global(p),
    & :global(ul),
    & :global(ol) {
      margin: 0 0 var(--space-4);
    }

    & :global(ul),
    & :global(ol) {
      padding-inline-start: var(--space-6);
    }

    & :global(li + li) {
      margin-top: var(--space-1);
    }

    /* « Pour comprendre », intitulés officiels : explications en retrait. */
    & :global(p > em:only-child) {
      display: block;
      padding: var(--space-2) var(--space-3);
      background: var(--detail-muted);
      border-inline-start: 3px solid var(--modal-border);
      color: var(--modal-ink-secondary);
    }

    & :global(a) {
      color: var(--brand-indigo);
      text-decoration: underline;
    }

    & :global(blockquote) {
      margin: var(--space-4) 0;
      padding-inline-start: var(--space-4);
      border-inline-start: 4px solid var(--modal-border);
      color: var(--modal-ink-secondary);
      font-style: italic;
    }

    /* Tableaux : défilement horizontal sur mobile plutôt que débordement. */
    & :global(table) {
      display: block;
      max-width: 100%;
      margin: 0 0 var(--space-4);
      overflow-x: auto;
      border-collapse: collapse;
      font-size: var(--body-sm-size);
    }

    & :global(th),
    & :global(td) {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--modal-border);
      text-align: start;
      vertical-align: top;
      overflow-wrap: normal;
    }

    & :global(th) {
      background: var(--detail-muted);
      font-weight: 600;
    }
  }
</style>
