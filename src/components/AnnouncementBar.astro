---
// TODO: PUBLIC_DONATE_URL à définir ; vide = accroche et bouton masqués.
const donateUrl = import.meta.env.PUBLIC_DONATE_URL;
---

<div class="bar">
  <p class="text">
    ChatVote est une initiative associative open source et souveraine<span class="extra"> - la fiabilité de l'information fournie est notre priorité.</span> Version 1.0
  </p>
  {
    donateUrl && (
      <div class="cta">
        <span class="hook">Aidez-nous à aider la démocratie !</span>
        <a class="button" href={donateUrl}>Soutenir</a>
      </div>
    )
  }
</div>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--gutter);
    background: var(--surface-200);
    border-bottom: 1px solid var(--border);
    color: var(--ink-secondary);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-line);
  }

  .extra,
  .hook {
    display: none;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .button {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--brand-orange);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .extra {
      display: inline;
    }

    .hook {
      display: inline;
      color: var(--ink);
      font-weight: 600;
    }
  }
</style>
