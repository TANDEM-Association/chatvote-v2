---
import DonateButton from "./DonateButton.astro";

// Masqué sous 768 px pour laisser la hauteur au chat : sur mobile, le bouton
// « Soutenir » est dans le header.
// TODO: PUBLIC_MORE_URL à définir ; vide = lien masqué.
const moreUrl = import.meta.env.PUBLIC_MORE_URL;
---

<div class="bar">
  <p class="text">
    <span class="long">ChatVote est une initiative associative open source et souveraine - la fiabilité de l'information fournie est notre priorité</span>
    <span class="medium">ChatVote - open source et souveraine</span>
  </p>
  <div class="actions">
    {
      moreUrl && (
        <a class="more" href={moreUrl} target="_blank" rel="noopener noreferrer">
          En savoir plus<span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
        </a>
      )
    }
    <DonateButton />
  </div>
</div>

<style>
  .bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-indigo);
    border-bottom: 1px solid var(--border);
    color: var(--ink);
  }

  .text {
    flex: 1;
    min-width: 0;
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .long {
    display: none;
  }

  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
  }

  .more {
    display: none;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .bar {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .text {
      font-size: 0.875rem;
    }

    .more {
      display: inline-flex;
    }
  }

  @media (min-width: 1280px) {
    .medium {
      display: none;
    }

    .long {
      display: inline;
    }
  }
</style>
