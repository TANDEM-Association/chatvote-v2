---
// Remplace le widget Zaq quand la commune n'est pas ouverte (ou introuvable).
// Aucun script Zaq ici : ni jeton, ni cookie. Le conteneur porte [data-chat-frame]
// pour que la bascule « Comptes rendus » (records-modal.ts) fonctionne aussi.
//
// Textes PROVISOIRES, à personnaliser avec le porteur du projet (CTA crowdfunding).

interface Props {
  variant: "unavailable" | "not-found";
  communeName?: string;
}

const { variant, communeName } = Astro.props;
const donateUrl = import.meta.env.PUBLIC_DONATE_URL;

const content =
  variant === "unavailable"
    ? {
        title: `${communeName} n'est pas encore disponible dans ChatVote`,
        text: "Nous ouvrons les communes une à une. Votre soutien nous aide à accueillir la vôtre plus vite.",
      }
    : {
        title: "Cette commune est introuvable",
        text: "Le code de commune demandé ne correspond à aucune commune française.",
      };
---

<div class="stage" data-chat-frame>
  <div class="notice">
    <img
      class="logo"
      src="/logo-chatvote.svg"
      alt=""
      width="500"
      height="500"
    />
    <h1 class="title">{content.title}</h1>
    <p class="text">{content.text}</p>
    <div class="actions">
      {
        variant === "unavailable" && donateUrl && (
          <a
            class="button"
            href={donateUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Soutenir ChatVote
            <span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
          </a>
        )
      }
      <a class="link" href="/">Revenir à l'accueil</a>
    </div>
  </div>
</div>

<style>
  .stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: var(--gutter);
  }

  .notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 34rem;
    text-align: center;
  }

  .logo {
    width: clamp(5rem, 22dvh, 10rem);
    height: auto;
  }

  .title {
    font-size: var(--display-md-size);
    line-height: var(--display-md-line);
    font-weight: 800;
    text-wrap: balance;
  }

  .text {
    color: var(--ink-secondary);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .button {
    padding: var(--space-3) var(--space-6);
    background: var(--brand-indigo);
    border-radius: var(--radius-full);
    color: #fff;
    font-weight: 700;
    text-decoration: none;

    &:hover {
      filter: brightness(1.15);
    }
  }

  .link {
    color: var(--ink-secondary);
    font-size: var(--body-sm-size);

    &:hover {
      color: var(--ink);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
