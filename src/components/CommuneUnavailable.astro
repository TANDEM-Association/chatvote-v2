---
// Remplace le widget Zaq quand la commune n'est pas ouverte (ou introuvable).
// Aucun script Zaq ici : ni jeton, ni cookie. Le conteneur porte [data-chat-frame]
// pour que la bascule « Comptes rendus » (records-modal.ts) fonctionne aussi.
//

interface Props {
  variant: "unfunded" | "partially-funded" | "funded" | "not-found";
  communeName?: string;
  /** Premier code postal de la commune, `undefined` s'il n'y en a aucun. */
  communePostalCode?: string | undefined;
}

const { variant, communeName, communePostalCode } = Astro.props;
const communeLabel = communePostalCode
  ? `${communeName} (${communePostalCode})`
  : communeName;
const donateUrl = import.meta.env.PUBLIC_DONATE_URL;

const notYetAvailable = `${communeLabel} n'est pas encore disponible dans ChatVote`;

const contents = {
  unfunded: {
    title: notYetAvailable,
    text: "Ouvrir une commune nous coûte 250€. Votre soutien nous aide à accueillir la vôtre plus vite.",
    cta: "Ouvrir cette commune",
  },
  "partially-funded": {
    title: notYetAvailable,
    text: "Ouvrir une commune nous coûte 250€. Une partie seulement a déjà été financée, votre financement complémentaire permettrait de l'accueillir au plus vite.",
    cta: "Ouvrir cette commune",
  },
  funded: {
    title: `${communeLabel} arrive bientôt dans ChatVote`,
    text: "Les 250€ nécessaires pour nous permettre d'accueillir cette commune ont été financés, nous travaillons à l'accueillir au plus vite. Mais vous pouvez nous soutenir ou financer une autre commune.",
    cta: "Soutenir Tandem",
  },
  "not-found": {
    title: "Cette commune est introuvable",
    text: "Le code de commune demandé ne correspond à aucune commune française.",
    cta: null,
  },
} as const;

const content = contents[variant];
---

<div class="stage" data-chat-frame>
  <div class="notice">
    <img
      class="logo"
      src="/logo-chatvote.svg"
      alt=""
      width="500"
      height="500"
    />
    <h1 class="title">{content.title}</h1>
    <p class="text">{content.text}</p>
    <div class="actions">
      {
        content.cta && donateUrl && (
          <a
            class="button"
            href={donateUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {content.cta}
            <span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
          </a>
        )
      }
      <a class="link" href="/">Revenir à l'accueil</a>
    </div>
  </div>
</div>

<style>
  .stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: var(--gutter);
  }

  .notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 34rem;
    text-align: center;
  }

  .logo {
    width: clamp(5rem, 22dvh, 10rem);
    height: auto;
  }

  .title {
    font-size: var(--display-md-size);
    line-height: var(--display-md-line);
    font-weight: 800;
    text-wrap: balance;
  }

  .text {
    color: var(--ink);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .button {
    padding: var(--space-3) var(--space-6);
    background: var(--brand-orange);
    border-radius: var(--radius-full);
    color: #fff;
    font-weight: 700;
    text-decoration: none;

    /* Le contour de focus est orange aussi : on le décale pour qu'il reste visible. */
    &:focus-visible {
      outline-offset: 3px;
    }

    &:hover {
      filter: brightness(1.15);
    }
  }

  .link {
    color: var(--ink-secondary);
    font-size: var(--body-sm-size);

    &:hover {
      color: var(--ink);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
