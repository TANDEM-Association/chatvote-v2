---
import type { CollectionEntry } from "astro:content";

interface Props {
  /** Comptes rendus de la commune courante (filtrés par RecordsModal). */
  records: CollectionEntry<"records">[];
}

const records = Astro.props.records
  .map(({ id, data }) => ({
    id,
    ...data,
    count: data.items.length || data.deliberations,
    iso: data.date.toISOString().slice(0, 10),
    year: data.date.getUTCFullYear(),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const statusLabel = { ready: "Prêt", upcoming: "À venir" } as const;
---

<ul class="list" data-records-list>
  {
    records.map((record) => (
      <li>
        <button
          type="button"
          class="row"
          data-record-id={record.id}
          disabled={record.status !== "ready"}
        >
          <span class="date">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
            </svg>
            <span class="year">{record.year}</span>
          </span>
          <span class="text">
            <span class="title">{record.type} du {record.iso}</span>
            <span class="meta">
              {record.count} délibération{record.count > 1 ? "s" : ""}
            </span>
          </span>
          <span class="badge" data-status={record.status}>
            {statusLabel[record.status]}
          </span>
          <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </button>
      </li>
    ))
  }
</ul>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--modal-border);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-3) var(--gutter);
    background: transparent;
    border: 0;
    color: inherit;
    text-align: start;
    cursor: pointer;

    &:hover:not(:disabled) {
      background: color-mix(in srgb, var(--modal-ink) 4%, transparent);
    }

    &:disabled {
      cursor: default;
      opacity: 0.6;
    }
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 2.5rem;
    color: var(--modal-ink-secondary);
  }

  .year {
    font-size: 0.6875rem;
    line-height: 1;
  }

  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .title {
    font-weight: 500;
  }

  .meta {
    color: var(--modal-ink-secondary);
    font-size: var(--body-sm-size);
  }

  .badge {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;

    &[data-status="ready"] {
      background: var(--brand-indigo);
      color: #fff;
    }

    &[data-status="upcoming"] {
      border: 1px solid var(--modal-border);
      color: var(--modal-ink-secondary);
    }
  }

  .chevron {
    flex: none;
    color: var(--modal-ink-secondary);
  }
</style>
