---
import { formatDeliberations, formatSeanceDate } from "../lib/pv/pv-display";
import type { PvSeance } from "../lib/pv/pv-format";

interface Props {
  /** Séances de la commune courante, de la plus récente à la plus ancienne. */
  seances: PvSeance[];
}

const { seances } = Astro.props;
---

<ul class="list" data-records-list>
  {
    seances.map((seance) => (
      <li>
        <button type="button" class="row" data-record-id={seance.id}>
          <span class="date">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
            </svg>
            <span class="year">{seance.date.slice(0, 4)}</span>
          </span>
          <span class="text">
            <span class="title">Conseil municipal du {formatSeanceDate(seance.date)}</span>
            <span class="resume">{seance.resume}</span>
            <span class="meta">{formatDeliberations(seance.nbDeliberations)}</span>
          </span>
          <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </button>
      </li>
    ))
  }
</ul>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--modal-border);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-3) var(--gutter);
    background: transparent;
    border: 0;
    color: inherit;
    text-align: start;
    cursor: pointer;

    &:hover {
      background: color-mix(in srgb, var(--modal-ink) 4%, transparent);
    }
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    gap: 2px;
    min-width: 2.5rem;
    padding-top: 2px;
    color: var(--modal-ink-secondary);
  }

  .year {
    font-size: 0.6875rem;
    line-height: 1;
  }

  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .title {
    font-weight: 600;
  }

  /* Résumé sur deux lignes au plus ; le texte entier est dans le détail. */
  .resume {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: var(--body-sm-size);
  }

  .meta {
    color: var(--modal-ink-secondary);
    font-size: var(--body-sm-size);
  }

  .chevron {
    flex: none;
    color: var(--modal-ink-secondary);
  }
</style>
