---
import AnnouncementBar from "../components/AnnouncementBar.astro";
import CommunePopover from "../components/CommunePopover.astro";
import CommuneTrigger from "../components/CommuneTrigger.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  /** Pages sans contenu propre (commune non disponible, introuvable) : à ne pas indexer. */
  noindex?: boolean;
  /** Commune affichée (sélecteur) ; absente si elle est introuvable. */
  commune?: { code: string; name: string } | undefined;
}

const { title, description, noindex = false, commune } = Astro.props;

// Aperçus de partage (WhatsApp, réseaux sociaux) : URL absolues obligatoires.
// Pages à la demande : origine de la requête (correcte aussi sur les previews) ;
// pages prérendues : `site` (astro.config.mjs).
const origin = Astro.isPrerendered ? (Astro.site ?? Astro.url) : Astro.url;
const pageUrl = new URL(Astro.url.pathname + Astro.url.search, origin);
const ogImage = new URL("/og-image.png", origin);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:site_name" content="ChatVote" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ChatVote : comprenez ce que votre mairie décide"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#170742" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/Manrope-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <AnnouncementBar />
    <Header communeName={commune?.name} />
    <CommuneTrigger variant="bar" name={commune?.name} />
    <main>
      <slot />
    </main>
    <Footer />
    <CommunePopover currentCode={commune?.code} />
    <script>
      import "../scripts/matomo";
    </script>
  </body>
</html>
