# Durée de vie des cookies userID et conversationId, en secondes (provisoire : 12 mois)
PUBLIC_USER_ID_COOKIE_MAX_AGE=31536000
# Liens à définir plus tard
PUBLIC_DONATE_URL=
PUBLIC_LOGO_HREF=
# Lien du logo Tandem dans le header
PUBLIC_LOGO_TANDEM_HREF=
# Lien « En savoir plus » du bandeau (à définir)
PUBLIC_MORE_URL=

# --- Matomo (mesure d'audience, sans cookie de suivi) ---
# URL de l'instance Matomo, sans slash final (vide = désactivé).
# Son origine doit aussi figurer dans la CSP de vercel.json.
PUBLIC_MATOMO_URL=https://stats.tndm.fr
# Identifiant du site ChatVote dans Matomo (3). Matomo ignore les visites dont
# l'adresse n'est pas déclarée pour ce site (seule app.chatvote.org l'est).
PUBLIC_MATOMO_SITE_ID=3

# --- Widget Zaq ---
# URL de base du serveur Zaq (ngrok temporaire pour l'instant)
PUBLIC_ZAQ_URL=
# Préfixe de déploiement Zaq (vide si Zaq est servi à la racine)
PUBLIC_ZAQ_PATH_PREFIX=
PUBLIC_ZAQ_WIDGET_ID=
# Côté serveur uniquement (jamais de préfixe PUBLIC_)
# Clé de signature des jetons d'identité (HS256), fournie par Zaq
ZAQ_SIGNING_KEY=
# Doivent correspondre à identity_issuer / identity_audience côté Zaq
ZAQ_ISSUER=
ZAQ_AUDIENCE=

# --- PV augmentés ---
# Dossier pv/ du bucket Scaleway (avec /pv), lu par le serveur uniquement.
# Vide = aucun compte rendu.
PV_BASE_URL=
