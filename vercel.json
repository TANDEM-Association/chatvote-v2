{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://zaq-staging.51.159.27.173.sslip.io; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://zaq-staging.51.159.27.173.sslip.io wss://zaq-staging.51.159.27.173.sslip.io; frame-src https://zaq-staging.51.159.27.173.sslip.io; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), clipboard-write=(self \"https://zaq-staging.51.159.27.173.sslip.io\")"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://zaq-staging.51.159.27.173.sslip.io"
        }
      ]
    },
    {
      "source": "/communes-index.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/zaq-widget.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://zaq-staging.51.159.27.173.sslip.io"
        }
      ]
    }
  ]
}
